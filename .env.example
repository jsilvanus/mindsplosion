# Database: SQLite by default (.data/mindsplosion.sqlite). For PostgreSQL set DATABASE_URL
# and run `pnpm db:migrate` before starting.
# MINDSPLOSION_DB_PATH=.data/mindsplosion.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/mindsplosion

# --- HTTP MCP server (pnpm http / pnpm start:http) -------------------------------
# The HTTP server refuses to start unless OIDC_ISSUER and/or MINDSPLOSION_HTTP_TOKEN is set.
PORT=3000
HOST=0.0.0.0
# Public origin; OAuth issuer and <MCP_PUBLIC_URL>/mcp is the protected resource. Required (https) in production.
MCP_PUBLIC_URL=http://localhost:3000
# NODE_ENV=production
# TRUST_PROXY=true

# Static bearer token (>= 32 characters) for one principal, e.g. for clients that send a fixed header.
# MINDSPLOSION_HTTP_TOKEN=
# External subject of that principal; default is the stdio principal.
# MINDSPLOSION_HTTP_TOKEN_SUBJECT=default-principal

# OAuth for MCP clients with sign-in through an OpenID Connect provider (e.g. authentik).
# Leave OIDC_ISSUER empty to turn OAuth/OIDC off entirely (no /oauth, /oidc or .well-known routes).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_BUTTON_LABEL=Sign in with single sign-on
# OIDC_CREATE_USERS=false
# OIDC_TRUST_EMAIL=false
# Access-token signing secret, base64, >= 32 bytes (required when OIDC_ISSUER is set): openssl rand -base64 32
JWT_SECRET=
