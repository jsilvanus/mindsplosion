{
  "name": "mindsplosion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/mcp/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/mcp/server.js",
    "start:http": "node dist/http/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "node --loader ts-node/esm src/mcp/server.ts",
    "http": "node --loader ts-node/esm src/http/server.ts",
    "principal": "node --loader ts-node/esm src/cli/principal.ts",
    "db:migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "db:migrate:create": "node --loader ts-node/esm src/db/migrate-create.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
